# ── Database (MySQL) ─────────────────────────────────────────
# Cocok dengan MySQL Workbench lokal. Buat dulu database kosong: CREATE DATABASE partnerseek;
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=partnerseek
# Set ke "true" jika penyedia MySQL (mis. Aiven, TiDB Cloud, Railway) mewajibkan SSL
DB_SSL=false

# ── Auth ─────────────────────────────────────────────────────
# Isi dengan string acak panjang (min 32 karakter). Contoh: openssl rand -base64 48
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# ── Situs ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Analytics & Tracking (kosongkan jika belum dibuat) ───────
# Google Analytics 4, contoh: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Tag Manager, contoh: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Meta Pixel (angka)
NEXT_PUBLIC_META_PIXEL_ID=
